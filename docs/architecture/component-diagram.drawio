        <mxCell id="note" value="Código verificado en el repositorio. La verificación JWT no se aplica a todas las rutas: registro/login son públicos y generic mantiene middleware distinto. El proveedor y el hosting de PostgreSQL no se deducen de la conexión DATABASE_URL." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="35" y="600" width="1180" height="60" as="geometry"/></mxCell>
