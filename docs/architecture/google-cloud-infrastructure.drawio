        <mxCell id="pokeapi" value="PokeAPI&#10;integracion externa - generic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1540" y="700" width="210" height="75" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Diseno propuesto. Flujo: clientes -&gt; Apigee X (VerifyJWT) -&gt; PSC endpoint y service attachment -&gt; balanceador interno -&gt; Service/Pods GKE -&gt; Cloud SQL. Identity Platform se plantea como emisor OIDC/JWKS; el backend invoca PokeAPI por HTTPS. Red, TLS, egress y alta disponibilidad quedan por definir. Cloud SQL se muestra fuera de la VPC del cliente; el metodo de conectividad privada queda por definir." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="25" y="675" width="1445" height="100" as="geometry" />
        </mxCell>
        <mxCell id="auth-gap" value="Brecha de autenticacion: el backend actual valida JWT propios HS256. Apigee puede validar el JWT del proveedor de identidad, pero el token Identity Platform no pasara el middleware actual. Se requiere adaptar la verificacion del backend o definir intercambio de tokens; registro/login tambien debe migrarse al proveedor de identidad si ese es el flujo elegido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="800" width="1445" height="76" as="geometry" />
        </mxCell>
